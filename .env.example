# HubSpot Master Service Configuration Template

APP_NAME="HubSpot Master Service"
APP_ENV="development"
LOG_LEVEL="INFO"
DEBUG=False

# Database Configuration (PostgreSQL or SQLite fallback)
DATABASE_URL="sqlite:///./hubspot_master_service.db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# HubSpot API Configuration
HUBSPOT_API_BASE_URL="https://api.hubapi.com"
HUBSPOT_CLIENT_ID="your-hubspot-client-id"
HUBSPOT_CLIENT_SECRET="your-hubspot-client-secret"

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"
MINIO_SECURE=False
MINIO_BUCKET="hubspot-master-data"

# HMAC Security Keys (Dual-Key system)
HMAC_ENABLED=True
HMAC_SECRET_KEY_CORE="your-32-char-coordinator-secret-key"
HMAC_SECRET_KEY_ENGINEER="your-32-char-engineer-secret-key"
HMAC_SIGNATURE_MAX_AGE=300

# Maintenance & Heartbeat
HEARTBEAT_INTERVAL_SECONDS=15
CRASH_TIMEOUT_MINUTES=5
